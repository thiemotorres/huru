}\n    fun saveReminders(r: Set<Reminder>) { reminders = r; remindPrefs.edit().putStringSet(\"all\", r.map { it.encode() }.toSet()).apply() }\n    var due by remember { mutableStateOf<Reminder?>(null) } // banner shown for this one\n    var query by remember { mutableStateOf(\"\") }\n    var typing by remember { mutableStateOf(false) } // search keyboard open: stray focus must not switch the category\n    // Built off the main thread: thousands of channels would stall the first frame of the list.\n    val searchIndex by produceState(emptyList<Pair<Channel, String>>(), all) {\n        value = withContext(Dispatchers.Default) { all.map { it to searchKey(it.name) } }\n    }\n    // Locked categories show no channels, also not via favourites or recently watched.\n    fun channelsOf(cat: String?, closed: Set<String>) =\n        when (cat) {\n            in closed -> emptyList()\n            SEARCH -> searchKey(query.trim()).let { q ->\n                if (q.length < 2) emptyList()\n                else searchIndex.asSequence().filter { (ch, key) -> q in key && ch.categoryId !in closed }.map { it.first }.take(300).toList()\n            }\n            FAVORITES -> all.filter { it.id.toString() in favorites && it.categoryId !in closed }\n            RECENT -> all.associateBy { it.id }.let { byId -> recent.mapNotNull { byId[it] }.filter { it.categoryId !in closed } }\n            else -> byCategory[cat].orEmpty()\n        }\n    val loadingFailed = stringResource(R.string.loading_failed)\n\n    LaunchedEffect(x) {","is_error":false}]},"uuid":"c9043d3e-82e0-488d-b77f-f8bb79d4083d","timestamp":"2026-11-18T09:34:40.215Z","toolUseResult":{"stdout":"MainActivity.kt:74:val Night = Color(0xFF1E1520) // very dark plum app background\nMainActivity.kt:100:        when (mode) {\nMainActivity.kt:101:            0 -> BrowseScreen(\nMainActivity.kt:254:fun BrowseScreen(\nSplash.kt:28:val Plum = Color(0xFF3B1F3A)\nSplash.kt:29:val Coral = Color(0xFFFF6B4A)\nSplash.kt:30:val CoralDark = Col