s=rep(s,'''                    Field(stringResource(R.string.search_hint_channels), query, imeAction = ImeAction.Search) { query = it }''','''                    Field(stringResource(R.string.search_hint_channels), query, imeAction = ImeAction.Search, onTyping = { typing = it }) { query = it }''')\nopen(p,'w').write(s)\n\np='Vod.kt'; s=open(p).read()\ns=rep(s,'''    var query by remember { mutableStateOf(\"\") }''','''    var query by remember { mutableStateOf(\"\") }\n    var typing by remember { mutableStateOf(false) } // search keyboard open: stray focus must not switch the category''')\ns=rep(s,'''                                .onFocusChanged { if (it.isFocused) selected = cat.id },''','''                                .onFocusChanged { if (it.isFocused && !typing) selected = cat.id },''')\ns=rep(s,'''                Field(stringResource(R.string.search_hint), query, imeAction = ImeAction.Search) { query = it }''','''                Field(stringResource(R.string.search_hint), query, imeAction = ImeAction.Search, onTyping = { typing = it }) { query = it }''')\nopen(p,'w').write(s)\nEOF\ncd /Users/feto/dev/private/iptv && export JAVA_HOME=/opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home && ./gradlew -q assembleRelease -PversionCode=15 -PversionName=0.4.0-dev 2>&1 | /usr/bin/grep -E \"^e:|FAIL\" | head; adb install -r app/build/outputs/apk/release/app-release.apk | tail -1; S=/private/tmp/claude-501/-Users-feto-dev-private-iptv/18c64000-5932-46f4-8834-4cb9da4c4118/scratchpad; adb shell am start -n io.github.thiemotorres.huru/.MainActivity >/dev/null; sleep 10; adb shell input keyevent BACK; sleep 1.5; adb shell input keyevent DPAD_LEFT; sleep 0.5; for i in $(seq 1 15); do adb shell input keyevent DPAD_UP; sleep 0.35; b=$(bash $S/focus.sh 2>/dev/null | tail -1); y=$(echo \"$b\" | sed -E 's/.*\\[[0-9]+,([0-9]+)\\]\\[.*/\\1/'); [ -n \"$y\" ] && [ \"$y\" -lt 200 ] && [ \"$y\" -gt 110 ] && break; done; adb shell input keyevent DPAD_RIGHT; sleep 0.8; adb